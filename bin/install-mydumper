#!/usr/bin/env bash
# Builds mydumper and myloader into build/go-mydumper/bin from the Vitess fork the dumps have always been
# made with, pinned so a push to that branch can't change the dump format under us, plus patches/.
set -euo pipefail

REPO=https://github.com/aquarapid/go-mydumper.git
COMMIT=7dc2c9f9d01d0f7d417b12592fcceb06a7d2b65c # branch jacques_vitess

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
dir="$root/build/go-mydumper"
rm -rf "$dir"
git clone --quiet "$REPO" "$dir"
git -C "$dir" checkout --quiet "$COMMIT"
git -C "$dir" apply "$root"/patches/*.patch
make -C "$dir" build
