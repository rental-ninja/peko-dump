#!/usr/bin/env bash
# Dumps a database with MySQL Shell, uploads it as <name>.<yymmddHHMM>.tar.gz to every destination, then
# prunes old dumps there. The profile says what to dump: [mysql] database, threads and chunksize (MB), and
# [where], one row filter per table. The connection comes from the environment.
# With --clone it packs a physical, consistent copy of the whole instance (CLONE LOCAL) instead of a dump.
# With --recipient the archive is encrypted with age before it leaves the server, as <file>.tar.gz.age.
set -euo pipefail
umask 077

MYSQLSH=${MYSQLSH:-mysqlsh}
WORK_DIR=${WORK_DIR:-$HOME/.peko-dump}
DB_HOST=${DB_HOST:-127.0.0.1}
DB_PORT=${DB_PORT:-3306}
CLONE_DIR=${CLONE_DIR:-/var/lib/mysql-files}
MAX_NEWEST_AGE_HOURS=6
LOCK_WAIT_SECONDS=21600

CLONE=0
PROFILE=""
NAME=""
PREFIX=""
KEEP_DAYS=""
KEEP_AT_LEAST=""
HEARTBEAT=""
RECIPIENTS=()
RUN_DIR=""
CLONE_TARGET=""

usage() {
    cat <<EOF
Usage: $(basename "$0") --profile <file.cnf> --name <name> --prefix backups/daily/
       --keep-days 120 --keep-at-least 30 [--heartbeat https://hc-ping.com/<uuid>] [--recipient age1…]
       $(basename "$0") --clone --name <name> --prefix snapshots/
       --keep-days 14 --keep-at-least 7 [--heartbeat https://hc-ping.com/<uuid>] [--recipient age1…]

--clone copies the whole instance with CLONE LOCAL: run it as root on the database server itself.
--recipient encrypts the archive with age to that public key; repeat it for more keys. Needs age.

Environment:
  DB_USER, DB_PASSWORD   required
  DB_HOST, DB_PORT       default 127.0.0.1, 3306
  DESTINATIONS           required: space-separated <aws-profile>:<bucket>, e.g. "s3:<bucket> r2:<bucket>"
  MYSQLSH                default mysqlsh
  WORK_DIR               default ~/.peko-dump
  CLONE_DIR              default /var/lib/mysql-files: where mysqld may write the copy
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --profile) PROFILE="$2"; shift 2 ;;
        --clone) CLONE=1; shift ;;
        --name) NAME="$2"; shift 2 ;;
        --prefix) PREFIX="$2"; shift 2 ;;
        --keep-days) KEEP_DAYS="$2"; shift 2 ;;
        --keep-at-least) KEEP_AT_LEAST="$2"; shift 2 ;;
        --heartbeat) HEARTBEAT="$2"; shift 2 ;;
        --recipient) RECIPIENTS+=("$2"); shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Unknown argument: $1" >&2; usage >&2; exit 1 ;;
    esac
done

if { [ "$CLONE" -eq 1 ] && [ -n "$PROFILE" ]; } || { [ "$CLONE" -eq 0 ] && [ ! -f "$PROFILE" ]; } || [[ ! "$NAME" =~ ^[a-z0-9_-]+$ || "$PREFIX" != */ || ! "$KEEP_DAYS" =~ ^[0-9]+$ || ! "$KEEP_AT_LEAST" =~ ^[1-9][0-9]*$ ]]; then
    usage >&2
    exit 1
fi
: "${DB_USER:?DB_USER is required}"
: "${DB_PASSWORD:?DB_PASSWORD is required}"
: "${DESTINATIONS:?DESTINATIONS is required}"
if [ ${#RECIPIENTS[@]} -gt 0 ] && ! command -v age >/dev/null; then
    echo "--recipient needs age: apt install age" >&2
    exit 1
fi
# Checked before the dump, which can take an hour: age itself must accept every key.
for recipient in ${RECIPIENTS[@]+"${RECIPIENTS[@]}"}; do
    if [[ ! "$recipient" =~ ^age1[02-9ac-hj-np-z]+$ ]] || ! age -r "$recipient" </dev/null >/dev/null 2>&1; then
        echo "--recipient takes an age public key (age1…), not ${recipient:0:12}…" >&2
        exit 1
    fi
done

# Prints "key<TAB>value" for every key of one ini section; the value starts after the first = or :.
section() {
    awk -v wanted="$1" '
        /^[[:space:]]*\[/ { name = $0; gsub(/[][[:space:]]/, "", name); next }
        name != wanted || /^[[:space:]]*([#;]|$)/ { next }
        {
            split_at = match($0, /[=:]/)
            key = substr($0, 1, split_at - 1); value = substr($0, split_at + 1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", key); gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
            print key "\t" value
        }
    ' "$PROFILE"
}
setting() { section mysql | awk -F'\t' -v key="$1" '$1 == key && !found { print $2; found = 1 }'; }

if [ "$CLONE" -eq 1 ]; then
    # The copy is written by mysqld on its own disk and owned by mysql: only root on that server can pack it.
    if [ "$(id -u)" -ne 0 ] || [[ ! "$DB_HOST" =~ ^(127\.0\.0\.1|localhost|::1)$ ]]; then
        echo "--clone runs as root on the database server, with DB_HOST 127.0.0.1" >&2
        exit 1
    fi
else
    DATABASE=$(setting database)
    THREADS=$(setting threads)
    CHUNK_MB=$(setting chunksize)
    if [ -z "$DATABASE" ] || [[ ! "$THREADS" =~ ^[1-9][0-9]*$ || ! "$CHUNK_MB" =~ ^[1-9][0-9]*$ ]]; then
        echo "${PROFILE} needs database, threads and chunksize under [mysql]" >&2
        exit 1
    fi
    if [ -n "$(section select)" ]; then
        echo "${PROFILE} has [select] lines: MySQL Shell can't replace column values, remove them" >&2
        exit 1
    fi
fi

finish() {
    local rc=$?
    rm -rf "$RUN_DIR"
    # The copy holds the whole database: never leave it behind.
    [ -z "$CLONE_TARGET" ] || rm -rf "$CLONE_TARGET"
    if [ -n "$HEARTBEAT" ]; then
        curl -fsS -m 10 --retry 3 -o /dev/null "$HEARTBEAT/$rc" || true
    fi
    exit "$rc"
}
trap finish EXIT

mkdir -p "$WORK_DIR"
exec 9>"$WORK_DIR/lock"
if ! flock -w "$LOCK_WAIT_SECONDS" 9; then
    echo "Another dump still holds ${WORK_DIR}/lock after ${LOCK_WAIT_SECONDS}s" >&2
    exit 1
fi
if [ -n "$HEARTBEAT" ]; then
    curl -fsS -m 10 --retry 3 -o /dev/null "$HEARTBEAT/start" || true
fi
# Holding the lock, any run directory or copy left is from a run that was killed before its trap ran.
rm -rf "$WORK_DIR"/run.*
[ "$CLONE" -eq 0 ] || rm -rf "$CLONE_DIR/${NAME}.clone."*
RUN_DIR=$(mktemp -d "$WORK_DIR/run.XXXXXX")

FILE="${NAME}.$(date -u +%y%m%d%H%M).tar.gz"
[ ${#RECIPIENTS[@]} -eq 0 ] || FILE="${FILE}.age"
TARBALL="$RUN_DIR/$FILE"
DUMP_DIR="$RUN_DIR/dump"

make_dump() {
    section where | jq -R -n \
        --arg database "$DATABASE" --arg outdir "$DUMP_DIR" \
        --argjson threads "$THREADS" --arg chunk "${CHUNK_MB}M" '
        {
            schemas: [$database],
            outdir: $outdir,
            options: {
                threads: $threads,
                bytesPerChunk: $chunk,
                where: ([inputs | split("\t") | {key: ($database + "." + .[0]), value: .[1]}] | from_entries),
                consistent: false,
                events: false,
                routines: false,
                triggers: false,
                showProgress: false
            }
        }' >"$RUN_DIR/dump.json"
    # Python, not JavaScript: Ubuntu's mysql-shell package is built without JavaScript.
    printf 'import json\njob = json.load(open(%s))\nutil.dump_schemas(job["schemas"], job["outdir"], job["options"])\n' \
        "$(jq -n --arg path "$RUN_DIR/dump.json" '$path')" >"$RUN_DIR/dump.py"

    echo "Dumping ${DB_HOST}:${DB_PORT}/${DATABASE} with $(basename "$PROFILE")"
    printf '%s\n' "$DB_PASSWORD" |
        "$MYSQLSH" --host "$DB_HOST" --port "$DB_PORT" --user "$DB_USER" --passwords-from-stdin --py --file "$RUN_DIR/dump.py"
    if [ ! -f "$DUMP_DIR/@.done.json" ]; then
        echo "MySQL Shell exited without finishing the dump (no @.done.json)" >&2
        exit 1
    fi
}

# A consistent copy of every table at one moment. DDL waits while it runs; writes don't. peko-dump-clone.json
# names the binlog that was current when it began: replaying from there rolls the copy forward (with GTIDs
# on, the transactions it already holds are skipped). CLONE LOCAL itself leaves the binlog position empty.
make_clone() {
    local client="$RUN_DIR/client.cnf" datadir binlog_base size free status start_file="" start_position="" exclude=()
    printf '[client]\nhost=%s\nport=%s\nuser=%s\npassword=%s\n' "$DB_HOST" "$DB_PORT" "$DB_USER" "$DB_PASSWORD" >"$client"
    sql() { mysql --defaults-extra-file="$client" -N -B -e "$1"; }

    if [ "$(sql "SELECT PLUGIN_STATUS FROM information_schema.PLUGINS WHERE PLUGIN_NAME = 'clone'")" != ACTIVE ]; then
        echo "The clone plugin isn't active: INSTALL PLUGIN clone SONAME 'mysql_clone.so'" >&2
        return 1
    fi
    datadir=$(sql "SELECT @@datadir")
    binlog_base=$(sql "SELECT IFNULL(@@log_bin_basename, '')")
    if [ ! -d "$datadir" ]; then
        echo "${datadir} isn't on this machine: --clone runs on the database server" >&2
        return 1
    fi
    # A full disk stops the database: the copy and its archive must both fit with room to spare.
    [ -z "$binlog_base" ] || exclude=(--exclude="$(basename "$binlog_base").*")
    size=$(du -sb "${exclude[@]}" "$datadir" 2>/dev/null | cut -f1) || true
    if [[ ! "$size" =~ ^[0-9]+$ ]]; then
        echo "Couldn't measure ${datadir}" >&2
        return 1
    fi
    free=$(df --output=avail -B1 "$CLONE_DIR" | tail -1)
    if [ "$free" -lt $((size * 2)) ] || [ "$(df --output=avail -B1 "$WORK_DIR" | tail -1)" -lt "$size" ]; then
        echo "Not enough disk for a copy of $((size >> 30)) GiB: ${CLONE_DIR} has $((free >> 30)) GiB free" >&2
        return 1
    fi

    CLONE_TARGET="$CLONE_DIR/${NAME}.clone.$(date -u +%y%m%d%H%M%S)"
    # Needs REPLICATION CLIENT; empty when the binlog is off.
    read -r start_file start_position _ <<<"$(sql "SHOW BINARY LOG STATUS")" || true
    echo "Cloning ${DB_HOST}:${DB_PORT} into ${CLONE_TARGET}"
    sql "CLONE LOCAL DATA DIRECTORY = '${CLONE_TARGET}'"
    status=$(sql "SELECT JSON_OBJECT('state', STATE, 'begin_time', BEGIN_TIME, 'end_time', END_TIME, 'version', @@version)
        FROM performance_schema.clone_status" |
        jq --arg file "$start_file" --arg position "$start_position" \
            '. + {binlog_file_at_start: $file, binlog_position_at_start: $position}')
    if [ "$(jq -r '.state' <<<"$status")" != Completed ]; then
        echo "The clone didn't complete: ${status}" >&2
        return 1
    fi
    jq . <<<"$status" >"$CLONE_TARGET/peko-dump-clone.json"
    jq -r '"Copied \(.begin_time) to \(.end_time); binlog at start \(.binlog_file_at_start):\(.binlog_position_at_start)"' <<<"$status"
    DUMP_DIR=$CLONE_TARGET
}

if [ "$CLONE" -eq 1 ]; then make_clone; else make_dump; fi

echo "Packing ${FILE}"
if [ ${#RECIPIENTS[@]} -eq 0 ]; then
    tar --use-compress-program=pigz -cf "$TARBALL" -C "$DUMP_DIR" .
else
    # Piped, so the unencrypted archive never touches the disk.
    age_args=()
    for recipient in "${RECIPIENTS[@]}"; do age_args+=(-r "$recipient"); done
    tar -cf - -C "$DUMP_DIR" . | pigz | age "${age_args[@]}" -o "$TARBALL"
fi
echo "Packed to $(du -h "$TARBALL" | cut -f1)"

# Runs where set -e is off (its caller tests it), so every step that can fail returns explicitly.
prune() {
    local profile=$1 bucket=$2 listing selection total newest_age_hours expired batches batch result
    listing=$(aws --profile "$profile" s3api list-objects-v2 --bucket "$bucket" --prefix "$PREFIX" --output json) || return 1
    selection=$(jq -c \
        --arg prefix "$PREFIX" \
        --arg pattern "^${NAME}\\.[0-9]{10}\\.tar\\.gz(\\.age)?$" \
        --argjson now "$(date -u +%s)" \
        --argjson keep "$KEEP_AT_LEAST" \
        --argjson maxAgeDays "$KEEP_DAYS" '
        def epoch: sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601;
        [.Contents // [] | .[] | select((.Key | startswith($prefix)) and ((.Key | ltrimstr($prefix)) | test($pattern)))]
        | sort_by(.LastModified) | reverse
        | {
            total: length,
            newest_age_hours: (if length == 0 then null else (($now - (.[0].LastModified | epoch)) / 3600 | floor) end),
            expired: [.[$keep:][] | select(($now - (.LastModified | epoch)) > $maxAgeDays * 86400) | .Key]
        }' <<<"$listing") || return 1

    total=$(jq '.total' <<<"$selection")
    newest_age_hours=$(jq '.newest_age_hours' <<<"$selection")
    expired=$(jq '.expired | length' <<<"$selection")
    # The newest dump is the one just uploaded; if it isn't fresh, the listing can't be trusted to prune by.
    if [ "$total" -eq 0 ] || [ "$newest_age_hours" -gt "$MAX_NEWEST_AGE_HOURS" ]; then
        echo "Refusing to prune ${profile}:${bucket}/${PREFIX}: ${total} dumps, newest ${newest_age_hours}h old" >&2
        return 1
    fi

    echo "${profile}:${bucket}/${PREFIX}: ${total} dumps, ${expired} older than ${KEEP_DAYS} days beyond the newest ${KEEP_AT_LEAST}"
    if [ "$expired" -eq 0 ]; then
        return 0
    fi
    jq -r '.expired[]' <<<"$selection"
    batches=$(jq -c '.expired | [range(0; length; 1000) as $i | .[$i:$i + 1000]] | .[] | {Objects: map({Key: .})}' <<<"$selection") || return 1
    while read -r batch; do
        result=$(aws --profile "$profile" s3api delete-objects --bucket "$bucket" --delete "$batch" --output json) || return 1
        if [ "$(jq '.Errors // [] | length' <<<"$result")" -ne 0 ]; then
            echo "$result" >&2
            return 1
        fi
    done <<<"$batches"
}

# Every destination gets its copy before any is pruned, and one failing destination doesn't stop the others.
failed=0
uploaded=()
for destination in $DESTINATIONS; do
    echo "Uploading to ${destination}/${PREFIX}${FILE}"
    if aws --profile "${destination%%:*}" s3 cp --only-show-errors "$TARBALL" "s3://${destination#*:}/${PREFIX}${FILE}"; then
        uploaded+=("$destination")
    else
        echo "Upload to ${destination} failed" >&2
        failed=1
    fi
done
for destination in "${uploaded[@]}"; do
    prune "${destination%%:*}" "${destination#*:}" || failed=1
done

if [ "$failed" -ne 0 ]; then
    exit 1
fi
echo "Done: ${FILE}"
