#!/usr/bin/env bash
# Dumps a database with MySQL Shell, uploads it as <name>.<yymmddHHMM>.tar.gz to every destination, then
# prunes old dumps there. The profile says what to dump: [mysql] database, threads and chunksize (MB), and
# [where], one row filter per table. The connection comes from the environment.
set -euo pipefail
umask 077

MYSQLSH=${MYSQLSH:-mysqlsh}
WORK_DIR=${WORK_DIR:-$HOME/.peko-dump}
DB_HOST=${DB_HOST:-127.0.0.1}
DB_PORT=${DB_PORT:-3306}
MAX_NEWEST_AGE_HOURS=6
LOCK_WAIT_SECONDS=21600

PROFILE=""
NAME=""
PREFIX=""
KEEP_DAYS=""
KEEP_AT_LEAST=""
HEARTBEAT=""
RUN_DIR=""

usage() {
    cat <<EOF
Usage: $(basename "$0") --profile <file.cnf> --name <name> --prefix backups/daily/
       --keep-days 120 --keep-at-least 30 [--heartbeat https://hc-ping.com/<uuid>]

Environment:
  DB_USER, DB_PASSWORD   required
  DB_HOST, DB_PORT       default 127.0.0.1, 3306
  DESTINATIONS           required: space-separated <aws-profile>:<bucket>, e.g. "s3:<bucket> r2:<bucket>"
  MYSQLSH                default mysqlsh
  WORK_DIR               default ~/.peko-dump
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --profile) PROFILE="$2"; shift 2 ;;
        --name) NAME="$2"; shift 2 ;;
        --prefix) PREFIX="$2"; shift 2 ;;
        --keep-days) KEEP_DAYS="$2"; shift 2 ;;
        --keep-at-least) KEEP_AT_LEAST="$2"; shift 2 ;;
        --heartbeat) HEARTBEAT="$2"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Unknown argument: $1" >&2; usage >&2; exit 1 ;;
    esac
done

if [ ! -f "$PROFILE" ] || [[ ! "$NAME" =~ ^[a-z0-9_-]+$ || "$PREFIX" != */ || ! "$KEEP_DAYS" =~ ^[0-9]+$ || ! "$KEEP_AT_LEAST" =~ ^[1-9][0-9]*$ ]]; then
    usage >&2
    exit 1
fi
: "${DB_USER:?DB_USER is required}"
: "${DB_PASSWORD:?DB_PASSWORD is required}"
: "${DESTINATIONS:?DESTINATIONS is required}"

# Prints "key<TAB>value" for every key of one ini section; the value starts after the first = or :.
section() {
    awk -v wanted="$1" '
        /^[[:space:]]*\[/ { name = $0; gsub(/[][[:space:]]/, "", name); next }
        name != wanted || /^[[:space:]]*([#;]|$)/ { next }
        {
            split_at = match($0, /[=:]/)
            key = substr($0, 1, split_at - 1); value = substr($0, split_at + 1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", key); gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
            print key "\t" value
        }
    ' "$PROFILE"
}
setting() { section mysql | awk -F'\t' -v key="$1" '$1 == key && !found { print $2; found = 1 }'; }

DATABASE=$(setting database)
THREADS=$(setting threads)
CHUNK_MB=$(setting chunksize)
if [ -z "$DATABASE" ] || [[ ! "$THREADS" =~ ^[1-9][0-9]*$ || ! "$CHUNK_MB" =~ ^[1-9][0-9]*$ ]]; then
    echo "${PROFILE} needs database, threads and chunksize under [mysql]" >&2
    exit 1
fi
if [ -n "$(section select)" ]; then
    echo "${PROFILE} has [select] lines: MySQL Shell can't replace column values, remove them" >&2
    exit 1
fi

finish() {
    local rc=$?
    rm -rf "$RUN_DIR"
    if [ -n "$HEARTBEAT" ]; then
        curl -fsS -m 10 --retry 3 -o /dev/null "$HEARTBEAT/$rc" || true
    fi
    exit "$rc"
}
trap finish EXIT

mkdir -p "$WORK_DIR"
exec 9>"$WORK_DIR/lock"
if ! flock -w "$LOCK_WAIT_SECONDS" 9; then
    echo "Another dump still holds ${WORK_DIR}/lock after ${LOCK_WAIT_SECONDS}s" >&2
    exit 1
fi
if [ -n "$HEARTBEAT" ]; then
    curl -fsS -m 10 --retry 3 -o /dev/null "$HEARTBEAT/start" || true
fi
# Holding the lock, any run directory left is from a run that was killed before its trap ran.
rm -rf "$WORK_DIR"/run.*
RUN_DIR=$(mktemp -d "$WORK_DIR/run.XXXXXX")

FILE="${NAME}.$(date -u +%y%m%d%H%M).tar.gz"
TARBALL="$RUN_DIR/$FILE"
DUMP_DIR="$RUN_DIR/dump"

section where | jq -R -n \
    --arg database "$DATABASE" --arg outdir "$DUMP_DIR" \
    --argjson threads "$THREADS" --arg chunk "${CHUNK_MB}M" '
    {
        schemas: [$database],
        outdir: $outdir,
        options: {
            threads: $threads,
            bytesPerChunk: $chunk,
            where: ([inputs | split("\t") | {key: ($database + "." + .[0]), value: .[1]}] | from_entries),
            consistent: false,
            events: false,
            routines: false,
            triggers: false,
            showProgress: false
        }
    }' >"$RUN_DIR/dump.json"
# Python, not JavaScript: Ubuntu's mysql-shell package is built without JavaScript.
printf 'import json\njob = json.load(open(%s))\nutil.dump_schemas(job["schemas"], job["outdir"], job["options"])\n' \
    "$(jq -n --arg path "$RUN_DIR/dump.json" '$path')" >"$RUN_DIR/dump.py"

echo "Dumping ${DB_HOST}:${DB_PORT}/${DATABASE} with $(basename "$PROFILE")"
printf '%s\n' "$DB_PASSWORD" |
    "$MYSQLSH" --host "$DB_HOST" --port "$DB_PORT" --user "$DB_USER" --passwords-from-stdin --py --file "$RUN_DIR/dump.py"
if [ ! -f "$DUMP_DIR/@.done.json" ]; then
    echo "MySQL Shell exited without finishing the dump (no @.done.json)" >&2
    exit 1
fi

echo "Packing ${FILE}"
tar --use-compress-program=pigz -cf "$TARBALL" -C "$DUMP_DIR" .
echo "Packed to $(du -h "$TARBALL" | cut -f1)"

# Runs where set -e is off (its caller tests it), so every step that can fail returns explicitly.
prune() {
    local profile=$1 bucket=$2 listing selection total newest_age_hours expired batches batch result
    listing=$(aws --profile "$profile" s3api list-objects-v2 --bucket "$bucket" --prefix "$PREFIX" --output json) || return 1
    selection=$(jq -c \
        --arg prefix "$PREFIX" \
        --arg pattern "^${NAME}\\.[0-9]{10}\\.tar\\.gz$" \
        --argjson now "$(date -u +%s)" \
        --argjson keep "$KEEP_AT_LEAST" \
        --argjson maxAgeDays "$KEEP_DAYS" '
        def epoch: sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601;
        [.Contents // [] | .[] | select((.Key | startswith($prefix)) and ((.Key | ltrimstr($prefix)) | test($pattern)))]
        | sort_by(.LastModified) | reverse
        | {
            total: length,
            newest_age_hours: (if length == 0 then null else (($now - (.[0].LastModified | epoch)) / 3600 | floor) end),
            expired: [.[$keep:][] | select(($now - (.LastModified | epoch)) > $maxAgeDays * 86400) | .Key]
        }' <<<"$listing") || return 1

    total=$(jq '.total' <<<"$selection")
    newest_age_hours=$(jq '.newest_age_hours' <<<"$selection")
    expired=$(jq '.expired | length' <<<"$selection")
    # The newest dump is the one just uploaded; if it isn't fresh, the listing can't be trusted to prune by.
    if [ "$total" -eq 0 ] || [ "$newest_age_hours" -gt "$MAX_NEWEST_AGE_HOURS" ]; then
        echo "Refusing to prune ${profile}:${bucket}/${PREFIX}: ${total} dumps, newest ${newest_age_hours}h old" >&2
        return 1
    fi

    echo "${profile}:${bucket}/${PREFIX}: ${total} dumps, ${expired} older than ${KEEP_DAYS} days beyond the newest ${KEEP_AT_LEAST}"
    if [ "$expired" -eq 0 ]; then
        return 0
    fi
    jq -r '.expired[]' <<<"$selection"
    batches=$(jq -c '.expired | [range(0; length; 1000) as $i | .[$i:$i + 1000]] | .[] | {Objects: map({Key: .})}' <<<"$selection") || return 1
    while read -r batch; do
        result=$(aws --profile "$profile" s3api delete-objects --bucket "$bucket" --delete "$batch" --output json) || return 1
        if [ "$(jq '.Errors // [] | length' <<<"$result")" -ne 0 ]; then
            echo "$result" >&2
            return 1
        fi
    done <<<"$batches"
}

# Every destination gets its copy before any is pruned, and one failing destination doesn't stop the others.
failed=0
uploaded=()
for destination in $DESTINATIONS; do
    echo "Uploading to ${destination}/${PREFIX}${FILE}"
    if aws --profile "${destination%%:*}" s3 cp --only-show-errors "$TARBALL" "s3://${destination#*:}/${PREFIX}${FILE}"; then
        uploaded+=("$destination")
    else
        echo "Upload to ${destination} failed" >&2
        failed=1
    fi
done
for destination in "${uploaded[@]}"; do
    prune "${destination%%:*}" "${destination#*:}" || failed=1
done

if [ "$failed" -ne 0 ]; then
    exit 1
fi
echo "Done: ${FILE}"
